# Compose interpolation only. SITE_DOMAIN is a bare lowercase DNS name (no URL or port).
SITE_DOMAIN=play.example.com
# Compose derives PUBLIC_ORIGIN=https://${SITE_DOMAIN}; do not configure it independently.
MAX_CONNECTIONS=160
MAX_TCP_PER_IP=128
MAX_WS_PER_IP=80
WS_READ_TIMEOUT_MS=5000
INPUT_DELAY_FRAMES=6
# Game catalog: from the project root, copy config/games.json to deploy/games.json.
# The catalog and deploy/roms are mounted read-only; do not set ROM_PATH in Compose.
# No real secret here. Compose mounts deploy/secrets/access-password.txt as a secret.
